diff --git a/src/lib/datastream/BoundedFrameWriter.ts b/src/lib/datastream/BoundedFrameWriter.ts
new file mode 100644
index 0000000..bcb0389
--- /dev/null
+++ b/src/lib/datastream/BoundedFrameWriter.ts
@@ -0,0 +1,321 @@
+import type { Server } from 'node:net'
+/** Halo transport extension; cryptography and HDS wire framing remain upstream-owned. */
+import type { Duplex } from 'node:stream'
+
+/* global NodeJS */
+import { Buffer } from 'node:buffer'
+
+export class TransportError extends Error {
+  constructor(readonly code: 'busy' | 'closed' | 'aborted' | 'timeout' | 'encode' | 'io' | 'cleanup-pending') {
+    super(code)
+  }
+}
+interface Reservation {
+  resolve(): void
+  reject(error: Error): void
+  cleanup(): void
+  settled: boolean
+}
+export interface WriterLimits {
+  maximumFrameBytes: number
+  maximumPendingFrames: number
+  maximumPendingBytes: number
+  writeTimeoutMs: number
+  closeGraceMs: number
+  closeTimeoutMs: number
+}
+export interface SendOptions {
+  signal?: AbortSignal
+  onQueued?: () => void
+}
+/**
+ * Admission occurs BEFORE the supplied bounded encoder runs. There is no
+ * uncharged waiter queue. The socket has exactly one owner, and every write
+ * (legacy events, requests, responses and awaited recording data) uses it.
+ */
+export class BoundedFrameWriter {
+  private readonly pending = new Set<Reservation>()
+  private closing = false
+  private physicallyClosed = false
+  private readonly closeWaiters = new Set<() => void>()
+  private closeWork: Promise<void> | undefined
+  private physicalWait: Promise<void> | undefined
+  private readonly closedCallback: () => void
+  constructor(
+    private readonly socket: Duplex,
+    readonly limits: WriterLimits,
+  ) {
+    if (
+      Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)
+      || limits.maximumFrameBytes > 0xFFFFF + 20
+      || limits.maximumPendingFrames > 8
+      || limits.maximumPendingBytes < limits.maximumFrameBytes
+      || limits.maximumPendingBytes > 8 * (0xFFFFF + 20)
+      || limits.writeTimeoutMs > 30000
+      || limits.closeGraceMs > 5000
+      || limits.closeTimeoutMs > 5000
+    ) {
+      throw new TransportError('encode')
+    }
+    this.closedCallback = () => {
+      this.physicallyClosed = true
+      this.closing = true
+      for (const item of this.pending) {
+        item.cleanup()
+        if (!item.settled) {
+          item.reject(new TransportError('closed'))
+        }
+      }
+      this.pending.clear()
+      for (const callback of this.closeWaiters) {
+        callback()
+      }
+      this.closeWaiters.clear()
+    }
+    socket.on('close', this.closedCallback)
+    socket.on('error', () => {
+      void this.abort('io').catch(() => {})
+    })
+  }
+
+  get reservationCount(): number {
+    return this.pending.size
+  }
+
+  get chargedBytes(): number {
+    return this.pending.size * this.limits.maximumFrameBytes
+  }
+
+  get retirementComplete(): boolean {
+    return this.physicallyClosed
+  }
+
+  send(build: (maximumFrameBytes: number) => Buffer, options: SendOptions = {}): Promise<void> {
+    if (this.closing) {
+      throw new TransportError('closed')
+    }
+    if (options.signal?.aborted) {
+      throw new TransportError('aborted')
+    }
+    if (
+      this.pending.size >= this.limits.maximumPendingFrames
+      || this.chargedBytes + this.limits.maximumFrameBytes > this.limits.maximumPendingBytes
+    ) {
+      throw new TransportError('busy')
+    }
+    let resolve!: () => void, reject!: (error: Error) => void
+    const result = new Promise<void>((yes, no) => {
+      resolve = yes
+      reject = no
+    })
+    void result.catch(() => {})
+    let timer: NodeJS.Timeout | undefined
+    let callbackDone = false
+    let drainSeen = false
+    let writeReturned = false
+    let needDrain = false
+    const aborted = () => {
+      void this.abort('aborted').catch(() => {})
+    }
+    // The drain and completion callbacks reference one another.
+
+    let finish!: () => void
+    const socket = this.socket
+    const drained = () => {
+      drainSeen = true
+      finish()
+    }
+    const item: Reservation = {
+      resolve,
+      reject,
+      settled: false,
+      cleanup: () => {
+        if (timer) {
+          clearTimeout(timer)
+        }
+        options.signal?.removeEventListener('abort', aborted)
+        socket.off('drain', drained)
+      },
+    }
+    finish = () => {
+      if (this.closing || !writeReturned || !callbackDone || (needDrain && !drainSeen) || item.settled) {
+        return
+      }
+      item.settled = true
+      item.cleanup()
+      this.pending.delete(item)
+      item.resolve()
+    }
+    this.pending.add(item) // Before encoding, including reentrant encoder calls.
+    try {
+      const frame = build(this.limits.maximumFrameBytes)
+      if (!Buffer.isBuffer(frame) || frame.length < 1 || frame.length > this.limits.maximumFrameBytes) {
+        throw new TransportError('encode')
+      }
+      if (options.signal?.aborted) {
+        throw new TransportError('aborted')
+      }
+      options.signal?.addEventListener('abort', aborted, { once: true })
+      timer = setTimeout(() => {
+        void this.abort('timeout').catch(() => {})
+      }, this.limits.writeTimeoutMs)
+      socket.on('drain', drained)
+      needDrain = !socket.write(frame, (error) => {
+        if (error) {
+          void this.abort('io').catch(() => {})
+          return
+        }
+        callbackDone = true
+        finish()
+      })
+      writeReturned = true
+      if (!this.closing) {
+        options.onQueued?.()
+      }
+      finish()
+    } catch (error) {
+      // The encoder may already have consumed a nonce. Closing prevents reuse
+      // or a nonce gap on an otherwise surviving encrypted connection.
+      void this.abort(error instanceof TransportError
+        ? error.code
+        : 'encode').catch(() => {})
+    }
+    return result
+  }
+
+  async abort(code: TransportError['code'] = 'aborted'): Promise<void> {
+    this.beginClose(code)
+    this.socket.destroy()
+    await this.awaitPhysicalClose()
+  }
+
+  close(): Promise<void> {
+    if (!this.closeWork) {
+      this.closeWork = (async () => {
+        this.beginClose('closed')
+        if (!this.physicallyClosed) {
+          const force = setTimeout(() => this.socket.destroy(), this.limits.closeGraceMs)
+          this.socket.end()
+          try {
+            await this.awaitPhysicalClose(this.limits.closeGraceMs + this.limits.closeTimeoutMs)
+          } finally {
+            clearTimeout(force)
+          }
+        }
+      })().finally(() => {
+        this.closeWork = undefined
+      })
+    }
+    return this.closeWork
+  }
+
+  private beginClose(code: TransportError['code']): void {
+    if (this.closing) {
+      return
+    }
+    this.closing = true
+    for (const item of this.pending) {
+      item.cleanup()
+      if (!item.settled) {
+        item.settled = true
+        item.reject(new TransportError(code))
+      }
+    }
+    // Reservation release happens only on the actual close event.
+  }
+
+  private async awaitPhysicalClose(timeout = this.limits.closeTimeoutMs): Promise<void> {
+    if (this.physicallyClosed) {
+      return
+    }
+    if (!this.physicalWait) {
+      this.physicalWait = new Promise<void>((resolve, reject) => {
+        // Callback is installed before its timeout handle is assigned.
+
+        let timer: NodeJS.Timeout
+        const closed = () => {
+          clearTimeout(timer)
+          this.closeWaiters.delete(closed)
+          resolve()
+        }
+        timer = setTimeout(() => {
+          this.closeWaiters.delete(closed)
+          reject(new TransportError('cleanup-pending'))
+        }, timeout)
+        this.closeWaiters.add(closed)
+      }).finally(() => {
+        this.physicalWait = undefined
+      })
+    }
+    await this.physicalWait
+  }
+}
+
+/** Shared by every HDS server; no HDS object is created before admission. */
+export class PhysicalConnectionBudget {
+  private readonly owners = new Set<Duplex>()
+  private readonly servers = new Map<Server, number>()
+  constructor(
+    readonly maximum: number,
+    readonly maximumServers = 256,
+  ) {
+    if (
+      !Number.isSafeInteger(maximum)
+      || maximum < 1
+      || maximum > 256
+      || !Number.isSafeInteger(maximumServers)
+      || maximumServers < 1
+      || maximumServers > 256
+    ) {
+      throw new TransportError('encode')
+    }
+  }
+
+  /** Node >=22 drops before allocating a Socket when public maxConnections is zero. */
+  registerServer(server: Server, maximumConnections: number): void {
+    if (!Number.isSafeInteger(maximumConnections) || maximumConnections < 1 || maximumConnections > 256) {
+      throw new TransportError('encode')
+    }
+    if (this.servers.has(server) || this.servers.size >= this.maximumServers) {
+      throw new TransportError('busy')
+    }
+    this.servers.set(server, maximumConnections)
+    server.maxConnections = this.owners.size >= this.maximum
+      ? 0
+      : maximumConnections
+    Object.assign(server, { dropMaxConnection: true })
+    server.once('close', () => this.servers.delete(server))
+  }
+
+  private updateServers(): void {
+    for (const [server, maximum] of this.servers) {
+      server.maxConnections = this.owners.size >= this.maximum
+        ? 0
+        : maximum
+    }
+  }
+
+  get count(): number {
+    return this.owners.size
+  }
+
+  admit(socket: Duplex): boolean {
+    if (this.owners.has(socket)) {
+      throw new TransportError('encode')
+    }
+    if (socket.destroyed) {
+      return false
+    }
+    if (this.owners.size >= this.maximum) {
+      socket.destroy()
+      return false
+    }
+    this.owners.add(socket)
+    this.updateServers()
+    socket.once('close', () => {
+      this.owners.delete(socket)
+      this.updateServers()
+    })
+    return true
+  }
+}
diff --git a/src/lib/datastream/DataStreamBounds.ts b/src/lib/datastream/DataStreamBounds.ts
new file mode 100644
index 0000000..2603609
--- /dev/null
+++ b/src/lib/datastream/DataStreamBounds.ts
@@ -0,0 +1,152 @@
+import { Buffer } from 'node:buffer'
+/** Finite plain-data traversal before HDS serialization allocates key/value arrays. */
+import { types } from 'node:util'
+
+export function assertBoundedData(value: unknown, wrappers: readonly { readonly prototype: object }[] = []): void {
+  const ancestors = new Set<object>()
+  let nodes = 0
+  let keys = 0
+  let strings = 0
+  let bytes = 0
+  function visit(item: unknown, depth: number): void {
+    if (++nodes > 4096 || depth > 16) {
+      throw new Error('HDS value budget exceeded')
+    }
+    if (item === null || item === undefined || typeof item === 'boolean') {
+      return
+    }
+    if (typeof item === 'number') {
+      if (!Number.isFinite(item) || (Number.isInteger(item) && !Number.isSafeInteger(item))) {
+        throw new TypeError('Invalid HDS number')
+      }
+      return
+    }
+    if (typeof item === 'string') {
+      if (item.length > 65536) {
+        throw new Error('HDS string budget exceeded')
+      }
+      strings += Buffer.byteLength(item)
+      if (strings > 262144) {
+        throw new Error('HDS string budget exceeded')
+      }
+      return
+    }
+    if (typeof item !== 'object' || types.isProxy(item)) {
+      throw new Error('Invalid HDS value')
+    }
+    if (Buffer.isBuffer(item)) {
+      bytes += item.length
+      if (bytes > 0xFFFFF) {
+        throw new Error('HDS byte budget exceeded')
+      }
+      return
+    }
+    if (ancestors.has(item)) {
+      throw new Error('Cyclic HDS value')
+    }
+    ancestors.add(item)
+    if (Array.isArray(item)) {
+      if (item.length > 4096) {
+        throw new Error('HDS array budget exceeded')
+      }
+      for (let index = 0; index < item.length; index++) {
+        const property = Object.getOwnPropertyDescriptor(item, index)
+        if (!property || !('value' in property)) {
+          throw new Error('Invalid HDS array member')
+        }
+        visit(property.value, depth + 1)
+      }
+    } else {
+      const prototype = Object.getPrototypeOf(item)
+      if (prototype !== Object.prototype && prototype !== null && !wrappers.some(wrapper => wrapper.prototype === prototype)) {
+        throw new Error('Invalid HDS prototype')
+      }
+      let count = 0
+      for (const key in item) {
+        if (!Object.hasOwn(item, key) || ++keys > 1024 || ++count > 1024 || key.length > 128) {
+          throw new Error('HDS key budget exceeded')
+        }
+        const property = Object.getOwnPropertyDescriptor(item, key)
+        if (!property || !('value' in property)) {
+          throw new Error('HDS accessor is forbidden')
+        }
+        visit(key, depth + 1)
+        visit(property.value, depth + 1)
+      }
+    }
+    ancestors.delete(item)
+  }
+  visit(value, 0)
+}
+
+function record(value: unknown, allowed: readonly string[]): Record<string, unknown> {
+  if (
+    value === null
+    || typeof value !== 'object'
+    || types.isProxy(value)
+    || ![Object.prototype, null].includes(Object.getPrototypeOf(value))
+  ) {
+    throw new Error('Invalid recording record')
+  }
+  for (const key of allowed) {
+    const property = Object.getOwnPropertyDescriptor(value, key)
+    if (property && !('value' in property)) {
+      throw new Error('Invalid recording accessor')
+    }
+  }
+  let count = 0
+  for (const key in value) {
