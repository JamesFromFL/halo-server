+    || (metadata.dataSequenceNumber as number) < 1
+    || !Number.isSafeInteger(metadata.dataChunkSequenceNumber)
+    || (metadata.dataChunkSequenceNumber as number) < 1
+    || (metadata.dataChunkSequenceNumber as number) > 32
+    || typeof metadata.isLastDataChunk !== 'boolean'
+    || (metadata.dataTotalSize !== undefined
