+  const failAndCheck = (storage: HAPFileStorage, handler: Mock, uncertain: boolean): HAPStorageError => {
+    let failure: unknown
+    try {
+      storage.setItemSync('key.json', { new: true })
+    } catch (error) {
+      failure = error
+    }
+    expect(failure).toBeInstanceOf(HAPStorageError)
+    expect((failure as HAPStorageError).uncertain).toBe(uncertain)
+    expect(handler).toHaveBeenCalledTimes(1)
+    expect(handler).toHaveBeenCalledWith(failure)
+    expect(() => storage.getItem('key.json')).toThrow(failure as Error)
+    expect(() => storage.setItemSync('other.json', 1)).toThrow(failure as Error)
+    expect(() => storage.removeItemSync('key.json')).toThrow(failure as Error)
+    expect(handler).toHaveBeenCalledTimes(1)
+    return failure as HAPStorageError
+  }
+
+  it('confirms intent before target mutation and target durability before clearing intent', () => {
+    const storage = guard()
+    const events: string[] = []
+    const sync = fs.fsyncSync
+    const rename = fs.renameSync
+    const unlink = fs.unlinkSync
+    vi.spyOn(fs, 'fsyncSync').mockImplementation((fd) => {
+      const name = descriptorName(fd)
+      events.push(fs.fstatSync(fd).isDirectory()
+        ? 'dir'
+        : name.endsWith(HAP_STORAGE_INTENT)
+          ? 'intent'
+          : 'temp')
+      sync(fd)
+    })
+    vi.spyOn(fs, 'renameSync').mockImplementation((source, target) => {
+      events.push('rename')
+      rename(source, target)
+    })
