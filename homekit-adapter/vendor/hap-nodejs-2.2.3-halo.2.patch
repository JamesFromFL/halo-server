+/** Halo transport extension; cryptography and HDS wire framing remain upstream-owned. */
+import type { Duplex } from "node:stream";
+import type { Server } from "node:net";
+export class TransportError extends Error {
+  constructor(readonly code: "busy" | "closed" | "aborted" | "timeout" | "encode" | "io" | "cleanup-pending") {
+    super(code);
+  }
+}
+interface Reservation {
+  resolve(): void; reject(error: Error): void; cleanup(): void; settled: boolean;
+}
+export interface WriterLimits {
+  maximumFrameBytes: number; maximumPendingFrames: number; maximumPendingBytes: number;
+  writeTimeoutMs: number; closeGraceMs: number; closeTimeoutMs: number;
+}
+export interface SendOptions {signal?: AbortSignal; onQueued?: () => void;}
+/**
+ * Admission occurs BEFORE the supplied bounded encoder runs. There is no
+ * uncharged waiter queue. The socket has exactly one owner, and every write
+ * (legacy events, requests, responses and awaited recording data) uses it.
+ */
+export class BoundedFrameWriter {
+  private readonly pending = new Set<Reservation>();
+  private closing = false;
+  private physicallyClosed = false;
+  private readonly closeWaiters = new Set<() => void>();
+  private closeWork: Promise<void> | undefined;
+  private physicalWait: Promise<void> | undefined;
+  private readonly closedCallback: () => void;
+  constructor(private readonly socket: Duplex, readonly limits: WriterLimits) {
+    if (Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1) ||
+      limits.maximumFrameBytes > 0xfffff + 20 || limits.maximumPendingFrames > 8 ||
+      limits.maximumPendingBytes < limits.maximumFrameBytes ||
+      limits.maximumPendingBytes > 8 * (0xfffff + 20) || limits.writeTimeoutMs > 30000 ||
+      limits.closeGraceMs > 5000 || limits.closeTimeoutMs > 5000) {
+      throw new TransportError("encode");
+    }
+    this.closedCallback = () => {
+      this.physicallyClosed = true; this.closing = true;
+      for (const item of this.pending) {
+        item.cleanup(); if (!item.settled) {
+          item.reject(new TransportError("closed"));
+        }
+      }
+      this.pending.clear();
+      for (const callback of this.closeWaiters) {
+        callback();
+      } this.closeWaiters.clear();
+    };
+    socket.on("close", this.closedCallback);
+    socket.on("error", () => {
+      void this.abort("io").catch(() => {});
+    });
+  }
+  get reservationCount(): number {
+    return this.pending.size;
+  }
+  get chargedBytes(): number {
+    return this.pending.size * this.limits.maximumFrameBytes;
+  }
+  get retirementComplete(): boolean {
+    return this.physicallyClosed;
+  }
+  send(build: (maximumFrameBytes: number) => Buffer, options: SendOptions = {}): Promise<void> {
+    if (this.closing) {
+      throw new TransportError("closed");
+    }
+    if (options.signal?.aborted) {
+      throw new TransportError("aborted");
+    }
+    if (this.pending.size >= this.limits.maximumPendingFrames ||
+      this.chargedBytes + this.limits.maximumFrameBytes > this.limits.maximumPendingBytes) {
+      throw new TransportError("busy");
+    }
+    let resolve!: () => void, reject!: (error: Error) => void;
+    const result = new Promise<void>((yes,no) => {
+      resolve=yes; reject=no;
+    }); void result.catch(() => {});
+    let timer: NodeJS.Timeout | undefined, callbackDone=false, drainSeen=false, writeReturned=false, needDrain=false;
+    const aborted = () => {
+      void this.abort("aborted").catch(() => {});
+    };
+    // The drain and completion callbacks reference one another.
+    // eslint-disable-next-line prefer-const
+    let finish!: () => void;
+    const socket = this.socket;
+    const drained = () => {
+      drainSeen=true; finish();
+    };
+    const item: Reservation = { resolve,reject,settled:false,cleanup:() => {
+      if (timer) {
+        clearTimeout(timer);
+      } options.signal?.removeEventListener("abort",aborted); socket.off("drain",drained);
+    } };
+    finish = () => {
+      if (this.closing || !writeReturned || !callbackDone || needDrain && !drainSeen || item.settled) {
+        return;
+      }
+      item.settled=true; item.cleanup(); this.pending.delete(item); item.resolve();
+    };
+    this.pending.add(item); // Before encoding, including reentrant encoder calls.
+    try {
+      const frame=build(this.limits.maximumFrameBytes);
+      if (!Buffer.isBuffer(frame) || frame.length < 1 || frame.length > this.limits.maximumFrameBytes) {
+        throw new TransportError("encode");
+      }
+      if (options.signal?.aborted) {
+        throw new TransportError("aborted");
+      }
+      options.signal?.addEventListener("abort",aborted,{ once:true });
+      timer=setTimeout(() => {
+        void this.abort("timeout").catch(() => {});
+      },this.limits.writeTimeoutMs);
+      socket.on("drain",drained);
+      needDrain=!socket.write(frame,error => {
+        if (error) {
+          void this.abort("io").catch(() => {});return;
+        }
+        callbackDone=true; finish();
+      });
+      writeReturned=true;
+      if (!this.closing) {
+        options.onQueued?.();
+      }
+      finish();
+    } catch (error) {
+      // The encoder may already have consumed a nonce. Closing prevents reuse
+      // or a nonce gap on an otherwise surviving encrypted connection.
+      void this.abort(error instanceof TransportError ? error.code : "encode").catch(() => {});
+    }
+    return result;
+  }
+  async abort(code: TransportError["code"] = "aborted"): Promise<void> {
+    this.beginClose(code); this.socket.destroy(); await this.awaitPhysicalClose();
+  }
+  close(): Promise<void> {
+    if (!this.closeWork) {
+      this.closeWork=(async()=>{
+        this.beginClose("closed");
+        if (!this.physicallyClosed) {
+          const force=setTimeout(()=>this.socket.destroy(),this.limits.closeGraceMs);
+          this.socket.end();
+          try {
+            await this.awaitPhysicalClose(this.limits.closeGraceMs+this.limits.closeTimeoutMs);
+          } finally {
+            clearTimeout(force);
+          }
+        }
+      })().finally(()=>{
+        this.closeWork=undefined;
+      });
+    }
+    return this.closeWork;
+  }
+  private beginClose(code: TransportError["code"]): void {
+    if (this.closing) {
+      return;
+    } this.closing=true;
+    for (const item of this.pending) {
+      item.cleanup(); if (!item.settled) {
+        item.settled=true;item.reject(new TransportError(code));
+      }
+    }
+    // Reservation release happens only on the actual close event.
+  }
+  private async awaitPhysicalClose(timeout=this.limits.closeTimeoutMs): Promise<void> {
+    if (this.physicallyClosed) {
+      return;
+    }
+    if (!this.physicalWait) {
+      this.physicalWait = new Promise<void>((resolve,reject)=>{
+        // Callback is installed before its timeout handle is assigned.
+        // eslint-disable-next-line prefer-const
+        let timer: NodeJS.Timeout;
+        const closed=()=>{
+          clearTimeout(timer);this.closeWaiters.delete(closed);resolve();
+        };
+        timer=setTimeout(()=>{
+          this.closeWaiters.delete(closed);reject(new TransportError("cleanup-pending"));
+        },timeout);
+        this.closeWaiters.add(closed);
+      }).finally(() => {
+        this.physicalWait = undefined;
+      });
+    }
+    await this.physicalWait;
+  }
+}
+
+/** Shared by every HDS server; no HDS object is created before admission. */
+export class PhysicalConnectionBudget {
+  private readonly owners=new Set<Duplex>();
+  private readonly servers=new Map<Server,number>();
+  constructor(readonly maximum:number, readonly maximumServers=256) {
+    if(!Number.isSafeInteger(maximum)||maximum<1||maximum>256||
+      !Number.isSafeInteger(maximumServers)||maximumServers<1||maximumServers>256) {
+      throw new TransportError("encode");
+    }
+  }
+  /** Node >=22 drops before allocating a Socket when public maxConnections is zero. */
+  registerServer(server:Server,maximumConnections:number):void {
+    if (!Number.isSafeInteger(maximumConnections) || maximumConnections < 1 || maximumConnections > 256) {
+      throw new TransportError("encode");
+    }
+    if(this.servers.has(server)||this.servers.size>=this.maximumServers) {
+      throw new TransportError("busy");
+    }
+    this.servers.set(server,maximumConnections);
+    server.maxConnections=this.owners.size>=this.maximum?0:maximumConnections;
+    Object.assign(server,{ dropMaxConnection:true });
+    server.once("close",()=>this.servers.delete(server));
+  }
+  private updateServers():void {
+    for(const [server,maximum] of this.servers) {
+      server.maxConnections=this.owners.size>=this.maximum?0:maximum;
+    }
+  }
+  get count():number{
+    return this.owners.size;
+  }
+  admit(socket:Duplex):boolean {
+    if(this.owners.has(socket)){
+      throw new TransportError("encode");
+    }
+    if(socket.destroyed){
+      return false;
+    }
+    if(this.owners.size>=this.maximum){
+      socket.destroy();return false;
+    }
+    this.owners.add(socket); this.updateServers();
+    socket.once("close",()=>{
+      this.owners.delete(socket);this.updateServers();
+    });return true;
+  }
+}
