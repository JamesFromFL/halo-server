+/** @group Model */
+export type HAPStorageFailureOperation = "initialize" | "write" | "remove";
+
+/** A latched persistence failure. Callers must retire cached model authority. @group Model */
+export class HAPStorageError extends Error {
+  readonly code: "storage-failed" | "storage-uncertain";
+
+  constructor(readonly operation: HAPStorageFailureOperation, readonly uncertain: boolean) {
+    super(uncertain ? "HAP storage commit is uncertain; owner recovery is required" : "HAP storage failed; owner recovery is required");
+    this.name = "HAPStorageError";
+    this.code = uncertain ? "storage-uncertain" : "storage-failed";
+  }
+}
+
+/** Runs synchronously once, before a failed mutation throws. Never log stored data. @group Model */
+export type HAPStorageFailureHandler = (failure: HAPStorageError) => void;
