+/** Finite plain-data traversal before HDS serialization allocates key/value arrays. */
+import { types } from "node:util";
+
+export function assertBoundedData(value: unknown, wrappers: readonly {readonly prototype: object}[] = []): void {
+  const ancestors = new Set<object>();
+  let nodes = 0, keys = 0, strings = 0, bytes = 0;
+  function visit(item: unknown, depth: number): void {
+    if (++nodes > 4096 || depth > 16) {
+      throw new Error("HDS value budget exceeded");
+    }
+    if (item === null || item === undefined || typeof item === "boolean") {
+      return;
+    }
+    if (typeof item === "number") {
+      if (!Number.isFinite(item) || Number.isInteger(item) && !Number.isSafeInteger(item)) {
+        throw new Error("Invalid HDS number");
+      }
+      return;
+    }
+    if (typeof item === "string") {
+      if (item.length > 65536 || (strings += Buffer.byteLength(item)) > 262144) {
+        throw new Error("HDS string budget exceeded");
+      }
+      return;
+    }
+    if (typeof item !== "object" || types.isProxy(item)) {
+      throw new Error("Invalid HDS value");
+    }
+    if (Buffer.isBuffer(item)) {
+      if ((bytes += item.length) > 0xfffff) {
+        throw new Error("HDS byte budget exceeded");
+      }
+      return;
+    }
+    if (ancestors.has(item)) {
+      throw new Error("Cyclic HDS value");
+    }
+    ancestors.add(item);
+    if (Array.isArray(item)) {
+      if (item.length > 4096) {
+        throw new Error("HDS array budget exceeded");
+      }
+      for (let index = 0; index < item.length; index++) {
+        const property = Object.getOwnPropertyDescriptor(item, index);
+        if (!property || !("value" in property)) {
+          throw new Error("Invalid HDS array member");
+        }
+        visit(property.value, depth + 1);
+      }
+    } else {
+      const prototype = Object.getPrototypeOf(item);
+      if (prototype !== Object.prototype && prototype !== null && !wrappers.some(wrapper => wrapper.prototype === prototype)) {
+        throw new Error("Invalid HDS prototype");
+      }
+      let count = 0;
+      for (const key in item) {
+        if (!Object.prototype.hasOwnProperty.call(item, key) || ++keys > 1024 || ++count > 1024 || key.length > 128) {
+          throw new Error("HDS key budget exceeded");
+        }
+        const property = Object.getOwnPropertyDescriptor(item, key);
+        if (!property || !("value" in property)) {
+          throw new Error("HDS accessor is forbidden");
+        }
+        visit(key, depth + 1);
+        visit(property.value, depth + 1);
+      }
+    }
+    ancestors.delete(item);
+  }
+  visit(value, 0);
+}
+
+function record(value: unknown, allowed: readonly string[]): Record<string, unknown> {
+  if (value === null || typeof value !== "object" || types.isProxy(value) ||
+    ![Object.prototype, null].includes(Object.getPrototypeOf(value))) {
+    throw new Error("Invalid recording record");
+  }
+  for (const key of allowed) {
+    const property = Object.getOwnPropertyDescriptor(value, key);
+    if (property && !("value" in property)) {
+      throw new Error("Invalid recording accessor");
+    }
+  }
+  let count = 0;
+  for (const key in value) {
+    if (++count > allowed.length || !allowed.includes(key) || !Object.prototype.hasOwnProperty.call(value, key)) {
+      throw new Error("Invalid recording key");
+    }
+    const property = Object.getOwnPropertyDescriptor(value, key);
+    if (!property || !("value" in property)) {
+      throw new Error("Invalid recording accessor");
+    }
+  }
+  return value as Record<string, unknown>;
+}
+
+export function assertRecordingData(value: unknown): void {
+  const message = record(value, ["streamId", "packets", "endOfStream"]);
+  if (!Number.isSafeInteger(message.streamId) || (message.streamId as number) < 0 ||
+    message.endOfStream !== undefined && typeof message.endOfStream !== "boolean" ||
+    !Array.isArray(message.packets) || types.isProxy(message.packets) || message.packets.length !== 1) {
+    throw new Error("Invalid recording event");
+  }
+  const packet = Object.getOwnPropertyDescriptor(message.packets, 0);
+  if (!packet || !("value" in packet)) {
+    throw new Error("Invalid recording packet accessor");
+  }
+  const item = record(packet.value, ["data", "metadata"]);
+  if (types.isProxy(item.data) || !Buffer.isBuffer(item.data) || item.data.length < 1 || item.data.length > 0x40000) {
+    throw new Error("Invalid recording chunk");
+  }
+  const metadata = record(item.metadata, ["dataType", "dataSequenceNumber", "dataChunkSequenceNumber", "isLastDataChunk", "dataTotalSize"]);
+  if (metadata.dataType !== "mediaInitialization" && metadata.dataType !== "mediaFragment" ||
+    !Number.isSafeInteger(metadata.dataSequenceNumber) || (metadata.dataSequenceNumber as number) < 1 ||
+    !Number.isSafeInteger(metadata.dataChunkSequenceNumber) || (metadata.dataChunkSequenceNumber as number) < 1 ||
+    (metadata.dataChunkSequenceNumber as number) > 32 || typeof metadata.isLastDataChunk !== "boolean" ||
+    metadata.dataTotalSize !== undefined && (!Number.isSafeInteger(metadata.dataTotalSize) ||
+      (metadata.dataTotalSize as number) < 1 || (metadata.dataTotalSize as number) > 8 * 1024 * 1024)) {
+    throw new Error("Invalid recording metadata");
+  }
+}
